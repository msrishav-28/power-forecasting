ENVIRONMENT=development

# Local Postgres. On Render, DATABASE_URL is injected automatically by the blueprint.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/powergrid

# Comma-separated CORS allowlist. In production, replace the placeholder with the actual Vercel URL,
# e.g. FRONTEND_ORIGINS=https://my-powergrid-dashboard.vercel.app
FRONTEND_ORIGINS=http://localhost:5173,https://<your-vercel-app>.vercel.app

# Optional: leave blank to skip Gemini features (the /api/llm/* endpoints fall back gracefully).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: leave blank to skip Qdrant-backed RAG (the /api/chat/rag endpoint falls back gracefully).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=powergrid-public-docs

# Optional: Hugging Face Hub fallback for model artifacts when local pickles are unavailable.
HUGGINGFACE_MODEL_REPO=

LLM_CACHE_TTL_HOURS=6
